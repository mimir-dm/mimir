{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "book.json",
	"version": "1.2.0",
	"type": "object",
	"properties": {
		"data": {
			"$ref": "../util.json#/$defs/adventureBookData"
		},
		"bookData": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"$ref": "../util.json#/$defs/corpusId"
					},
					"source": {
						"$ref": "../util.json#/$defs/source"
					},
					"data": {
						"$ref": "../util.json#/$defs/adventureBookData"
					}
				},
				"required": [
					"id",
					"source",
					"data"
				],
				"additionalProperties": false
			},
			"minItems": 1
		}
	},
	"additionalProperties": false,
	"description": "A 5etools book file: `data` (older files) or `bookData`, a wrapper with the id and source (current files and homebrew).",
	"minProperties": 1
}
