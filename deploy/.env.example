# The Mimir deployment (deploy/docker-compose.yaml).
# Copy to .env, then `chmod 600 .env`. NEVER commit it.

# The release tag of the image, never `latest`.
MIMIR_VERSION=1.0.0

# The DM token. Empty: open mode (anyone who can reach the server is the DM).
# Set it to a long random string to sign in with it. Players use their own
# links, which the DM makes per character.
MIMIR_API_TOKEN=

# Log level for mimir-server (RUST_LOG syntax): error, warn, info, debug.
# MIMIR_LOG_LEVEL=info

# --- Tailscale ---------------------------------------------------------------
# 1. Tailscale admin console → Settings → Keys → Generate auth key (a one-off
#    key is enough: the node's state stays in the `tailscale_state` volume).
# 2. DNS → enable HTTPS Certificates for the tailnet.
# 3. Start the stack.
# 4. In the admin console, disable key expiry for the new node.
TAILSCALE_AUTHKEY=
# The node's name, and so the address: https://<name>.<tailnet>.ts.net/
TAILSCALE_HOSTNAME=mimir
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:mimir. Without an auth
# key the node waits for a login link; --timeout gives you time to open it
# (the sidecar otherwise gives up and restarts with a new link each minute).
TAILSCALE_EXTRA_ARGS=--timeout=15m

# --- Backups -----------------------------------------------------------------
# The folder ON THE HOST for the backup archives. Default: ./backups.
# MIMIR_BACKUP_DIR=./backups
# Seconds between backups. Default 21600 (6 hours).
# MIMIR_BACKUP_INTERVAL=21600
# How many archives to keep. Default 8 (2 days at the default interval).
# MIMIR_BACKUP_KEEP=8
